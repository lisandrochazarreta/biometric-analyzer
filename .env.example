# Coordenadas de entrega (Av. Córdoba 4340, Villa Crespo, CABA)
PEYA_LAT=-34.5972
PEYA_LNG=-58.4359
PEYA_COUNTRY=AR

# Umbral de descuento (porcentaje, sin %). Notifica si discount > este valor.
DISCOUNT_THRESHOLD=80

# ntfy
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=pedidosya-mkt-descuentos-lis-x7k3m9q4

# Path del archivo de estado (dedupe)
STATE_FILE=.state/seen.json

# Opcional: filtrar a un vendor específico de PeYa Market (vendor_id).
# Si está vacío, el agente busca todos los vendors de "PeYa Market" / "PedidosYa Market" cercanos.
PEYA_VENDOR_ID=

# Opcional: cookie/headers capturados desde DevTools si el endpoint los requiere
PEYA_COOKIE=
PEYA_DEVICE_ID=

# =====================================================================
# Agente de carrito por WhatsApp  (paquete `carrito/`)
# =====================================================================

# --- Claude ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# low | medium | high | xhigh | max. Para chat de WhatsApp, low responde rápido.
CLAUDE_EFFORT=low
CLAUDE_MAX_TOKENS=4096
MAX_TOOL_ITERATIONS=12
HISTORY_TURNS=10

# --- Tiendas ---
# coto | jumbo | disco | vea | carrefour | dia | masonline
DEFAULT_STORE=coto
# Código postal para simular totales y disponibilidad (CABA por defecto)
POSTAL_CODE=1414
# Opcional: JSON para pisar hosts/sales channel sin tocar código.
# Ej: {"coto": {"host": "www.cotodigital3.com.ar"}}
STORES_FILE=

CARRITO_DB=.state/carrito.db
HTTP_TIMEOUT=25

# --- WhatsApp ---
WHATSAPP_PROVIDER=twilio
# OBLIGATORIO: números autorizados a usar el bot, separados por coma, en E.164.
# Si está vacío, el server rechaza todos los mensajes (y loguea el número que
# intentó, para que lo copies acá).
ALLOWED_NUMBERS=

# --- Twilio (WHATSAPP_PROVIDER=twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# El número del sandbox de Twilio es +14155238886
TWILIO_WHATSAPP_FROM=+14155238886
# URL pública del webhook (ngrok, Fly, Railway...). Se usa para validar la firma.
PUBLIC_URL=
VALIDATE_TWILIO_SIGNATURE=1

# --- Meta WhatsApp Cloud API (WHATSAPP_PROVIDER=meta) ---
META_TOKEN=
META_PHONE_NUMBER_ID=
META_VERIFY_TOKEN=
META_APP_SECRET=
META_API_VERSION=v22.0
